# JWT
JWT_SECRET=your_256_bit_hex_jwt_secret_here

# Database (MySQL)
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# SMTP Mail (notification-service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_APP_PASSWORD=your_gmail_app_password
MAIL_FROM=no-reply@qltro.local
APP_LOGIN_URL=http://localhost:3000/login

# VNPay Sandbox (payment-service)
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8888/api/v1/payments/vnpay-return


# Default Landlord Account (identity-service)
APP_SEED_LANDLORD_USERNAME=landlord
APP_SEED_LANDLORD_PASSWORD=your_landlord_password_here
APP_SEED_LANDLORD_EMAIL=landlord@qltro.local
